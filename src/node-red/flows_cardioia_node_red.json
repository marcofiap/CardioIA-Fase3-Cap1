[
  {
    "id": "cardioia-tab",
    "type": "tab",
    "label": "CardioIA Conectada",
    "disabled": false,
    "info": "Fluxo FIAP Grupo 57 para ESP32 -> MQTT -> Dashboard"
  },
  {
    "id": "mqtt-cardioia",
    "type": "mqtt in",
    "z": "cardioia-tab",
    "name": "MQTT CardioIA",
    "topic": "fiap/cardioia/grupo57/vitals",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "broker-hivemq-public",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 100,
    "wires": [["json-parse"]]
  },
  {
    "id": "json-parse",
    "type": "json",
    "z": "cardioia-tab",
    "name": "JSON",
    "property": "payload",
    "action": "",
    "pretty": false,
    "x": 330,
    "y": 100,
    "wires": [["log-terminal", "split-metrics", "debug-payload"]]
  },
  {
    "id": "log-terminal",
    "type": "function",
    "z": "cardioia-tab",
    "name": "Log terminal",
    "func": "node.warn('CardioIA MQTT recebido: ' + JSON.stringify(msg.payload));\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 60,
    "wires": [[]]
  },
  {
    "id": "split-metrics",
    "type": "function",
    "z": "cardioia-tab",
    "name": "Separar metricas e alerta",
    "func": "const p = msg.payload;\nreturn [\n  { payload: Number(p.bpm), topic: 'BPM' },\n  { payload: Number(p.temperature), topic: 'Temperatura' },\n  { payload: p.alert ? 'ALERTA: avaliar paciente' : 'Normal', topic: 'Alerta' },\n  { payload: p.alert ? 'red' : 'green', topic: 'Cor' }\n];",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 550,
    "y": 100,
    "wires": [["chart-bpm"], ["gauge-temp"], ["text-alert"], ["led-alert"]]
  },
  {
    "id": "chart-bpm",
    "type": "ui_chart",
    "z": "cardioia-tab",
    "name": "BPM em tempo real",
    "group": "ui-group-vitals",
    "order": 1,
    "width": 12,
    "height": 5,
    "label": "Batimentos por minuto",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Aguardando dados",
    "dot": false,
    "ymin": "40",
    "ymax": "180",
    "removeOlder": 10,
    "removeOlderPoints": "",
    "removeOlderUnit": "60",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#d0006f", "#009fe3", "#2ca02c"],
    "outputs": 1,
    "x": 820,
    "y": 60,
    "wires": [[]]
  },
  {
    "id": "gauge-temp",
    "type": "ui_gauge",
    "z": "cardioia-tab",
    "name": "Temperatura",
    "group": "ui-group-vitals",
    "order": 2,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Temperatura corporal",
    "label": "C",
    "format": "{{value}}",
    "min": 30,
    "max": "42",
    "colors": ["#00b050", "#f2c811", "#d13438"],
    "seg1": "37.5",
    "seg2": "38",
    "x": 800,
    "y": 110,
    "wires": []
  },
  {
    "id": "text-alert",
    "type": "ui_text",
    "z": "cardioia-tab",
    "group": "ui-group-alert",
    "order": 1,
    "width": 6,
    "height": 1,
    "name": "Texto de alerta",
    "label": "Status",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 810,
    "y": 160,
    "wires": []
  },
  {
    "id": "led-alert",
    "type": "ui_template",
    "z": "cardioia-tab",
    "group": "ui-group-alert",
    "name": "LED virtual",
    "order": 2,
    "width": 3,
    "height": 3,
    "format": "<div style=\"display:flex;align-items:center;gap:12px;height:100%;font-size:18px;\"><span style=\"width:42px;height:42px;border-radius:50%;display:inline-block;background:{{msg.payload}};box-shadow:0 0 14px {{msg.payload}};\"></span><b>{{msg.payload === 'red' ? 'Alerta' : 'Normal'}}</b></div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 800,
    "y": 210,
    "wires": [[]]
  },
  {
    "id": "debug-payload",
    "type": "debug",
    "z": "cardioia-tab",
    "name": "Payload recebido",
    "active": true,
    "tosidebar": true,
    "console": true,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 550,
    "y": 180,
    "wires": []
  },
  {
    "id": "broker-hivemq-public",
    "type": "mqtt-broker",
    "name": "HiveMQ public",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  },
  {
    "id": "ui-tab-cardioia",
    "type": "ui_tab",
    "name": "CardioIA",
    "icon": "dashboard",
    "disabled": false,
    "hidden": false
  },
  {
    "id": "ui-group-vitals",
    "type": "ui_group",
    "name": "Sinais vitais",
    "tab": "ui-tab-cardioia",
    "order": 1,
    "disp": true,
    "width": 12,
    "collapse": false,
    "className": ""
  },
  {
    "id": "ui-group-alert",
    "type": "ui_group",
    "name": "Alerta",
    "tab": "ui-tab-cardioia",
    "order": 2,
    "disp": true,
    "width": 12,
    "collapse": false,
    "className": ""
  }
]
