[
  {
    "id": "cardioia-tab",
    "type": "tab",
    "label": "CardioIA Conectada",
    "disabled": false,
    "info": "Fluxo FIAP Grupo 57 para ESP32 -> MQTT -> Dashboard"
  },
  {
    "id": "mqtt-cardioia",
    "type": "mqtt in",
    "z": "cardioia-tab",
    "name": "MQTT CardioIA",
    "topic": "fiap/cardioia/grupo57/vitals",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "broker-hivemq-public",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 100,
    "wires": [["normalize-vitals"]]
  },
  {
    "id": "inject-test",
    "type": "inject",
    "z": "cardioia-tab",
    "name": "Teste dashboard",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"deviceId\":\"inject-node-red\",\"timestamp\":0,\"temperature\":39.4,\"humidity\":40,\"bpm\":88,\"movement\":1,\"accelMagnitude\":11.2,\"alert\":true}",
    "payloadType": "json",
    "x": 140,
    "y": 170,
    "wires": [["normalize-vitals"]]
  },
  {
    "id": "normalize-vitals",
    "type": "function",
    "z": "cardioia-tab",
    "name": "Normalizar, logar e separar",
    "func": "let p = msg.payload;\n\nif (Buffer.isBuffer(p)) {\n  p = p.toString('utf8');\n}\n\nif (typeof p === 'string') {\n  try {\n    p = JSON.parse(p);\n  } catch (error) {\n    node.error('Payload MQTT invalido: ' + p, msg);\n    return null;\n  }\n}\n\nconst vitals = {\n  deviceId: p.deviceId || 'desconhecido',\n  timestamp: p.timestamp || Date.now(),\n  temperature: Number(p.temperature),\n  humidity: Number(p.humidity),\n  bpm: Number(p.bpm),\n  movement: Number(p.movement || 0),\n  accelMagnitude: Number(p.accelMagnitude || 0),\n  alert: Boolean(p.alert),\n};\n\nnode.warn('CardioIA MQTT recebido: ' + JSON.stringify(vitals));\n\nreturn [\n  { payload: vitals.bpm, topic: 'BPM' },\n  { payload: vitals.temperature, topic: 'Temperatura' },\n  { payload: vitals.alert ? 'ALERTA: avaliar paciente' : 'Normal', topic: 'Alerta' },\n  { payload: vitals.alert ? 'red' : 'green', topic: 'Cor' },\n  { payload: vitals.movement === 1 ? 'Em movimento' : 'Em repouso', topic: 'Movimento' },\n  { payload: vitals, topic: msg.topic || 'debug' }\n];",
    "outputs": 6,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 130,
    "wires": [["chart-bpm"], ["gauge-temp"], ["text-alert"], ["led-alert"], ["text-movement"], ["debug-payload"]]
  },
  {
    "id": "text-movement",
    "type": "ui_text",
    "z": "cardioia-tab",
    "group": "ui-group-alert",
    "order": 3,
    "width": 6,
    "height": 1,
    "name": "Movimento atual",
    "label": "Movimento",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 720,
    "y": 230,
    "wires": []
  },
  {
    "id": "chart-bpm",
    "type": "ui_chart",
    "z": "cardioia-tab",
    "name": "BPM em tempo real",
    "group": "ui-group-vitals",
    "order": 1,
    "width": 12,
    "height": 5,
    "label": "Batimentos por minuto",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Aguardando dados",
    "dot": false,
    "ymin": "40",
    "ymax": "180",
    "removeOlder": 10,
    "removeOlderPoints": "",
    "removeOlderUnit": "60",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#d0006f", "#009fe3", "#2ca02c"],
    "outputs": 1,
    "x": 730,
    "y": 60,
    "wires": [[]]
  },
  {
    "id": "gauge-temp",
    "type": "ui_gauge",
    "z": "cardioia-tab",
    "name": "Temperatura",
    "group": "ui-group-vitals",
    "order": 2,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Temperatura corporal",
    "label": "C",
    "format": "{{value}}",
    "min": 30,
    "max": "42",
    "colors": ["#00b050", "#f2c811", "#d13438"],
    "seg1": "37.5",
    "seg2": "38",
    "x": 710,
    "y": 110,
    "wires": []
  },
  {
    "id": "text-alert",
    "type": "ui_text",
    "z": "cardioia-tab",
    "group": "ui-group-alert",
    "order": 1,
    "width": 6,
    "height": 1,
    "name": "Texto de alerta",
    "label": "Status",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 720,
    "y": 160,
    "wires": []
  },
  {
    "id": "led-alert",
    "type": "ui_template",
    "z": "cardioia-tab",
    "group": "ui-group-alert",
    "name": "LED virtual",
    "order": 2,
    "width": 3,
    "height": 3,
    "format": "<div style=\"display:flex;align-items:center;gap:12px;height:100%;font-size:18px;\"><span style=\"width:42px;height:42px;border-radius:50%;display:inline-block;background:{{msg.payload}};box-shadow:0 0 14px {{msg.payload}};\"></span><b>{{msg.payload === 'red' ? 'Alerta' : 'Normal'}}</b></div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 710,
    "y": 210,
    "wires": [[]]
  },
  {
